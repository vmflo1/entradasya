SERVICE_NAME=orders
HOST=127.0.0.1
PORT=8003
LOG_LEVEL=INFO

# Base de datos propia del servicio
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orders_db
DB_USER=orders_user
DB_PASSWORD=cambiar_password
DB_TIMEZONE=America/La_Paz

# Secreto compartido para validar el JWT (el mismo en todos los servicios)
JWT_SECRET=cambiar_secreto_jwt
JWT_ALGORITHM=HS256

# Direcciones de los otros servicios
EVENTS_URL=http://127.0.0.1:8002
PAYMENTS_URL=http://127.0.0.1:8004
TICKETS_URL=http://127.0.0.1:8005
NOTIFICATIONS_URL=http://127.0.0.1:8006
# Clave para llamar a los servicios internos (payments y notifications)
INTERNAL_API_KEY=cambiar_clave_interna
# Tiempo maximo de espera (segundos) en cada llamada a otro servicio
HTTP_TIMEOUT=5

# Direccion publica de la web (para el enlace del correo)
PUBLIC_URL=http://localhost:8080
