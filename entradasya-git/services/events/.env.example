SERVICE_NAME=events
HOST=127.0.0.1
PORT=8002
LOG_LEVEL=INFO

# Base de datos propia del servicio
DB_HOST=localhost
DB_PORT=5432
DB_NAME=events_db
DB_USER=events_user
DB_PASSWORD=cambiar_password
DB_TIMEZONE=America/La_Paz

# Secreto compartido para validar el JWT (el mismo en todos los servicios)
JWT_SECRET=cambiar_secreto_jwt
JWT_ALGORITHM=HS256

# Carpeta local de las imagenes de los eventos (relativa a esta carpeta o absoluta)
IMAGES_DIR=./data/imagenes
