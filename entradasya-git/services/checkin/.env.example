SERVICE_NAME=checkin
HOST=127.0.0.1
PORT=8007
LOG_LEVEL=INFO

# Base de datos propia del servicio
DB_HOST=localhost
DB_PORT=5432
DB_NAME=checkin_db
DB_USER=checkin_user
DB_PASSWORD=cambiar_password
DB_TIMEZONE=America/La_Paz

# Secreto compartido para validar el JWT (el mismo en todos los servicios)
JWT_SECRET=cambiar_secreto_jwt
JWT_ALGORITHM=HS256

# Direccion del servicio tickets (para validar los codigos)
TICKETS_URL=http://127.0.0.1:8005
# Tiempo maximo de espera (segundos) en cada llamada a otro servicio
HTTP_TIMEOUT=5
